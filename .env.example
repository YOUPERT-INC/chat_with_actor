# Port the pm2 process listens on (nginx proxies /chat-ai/ to it)
PORT=8004

# Same MongoDB as swipex_nodejs (db swipexdevdb, collection actress_new is read-only here)
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/swipexdevdb
MONGODB_DB=swipexdevdb

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Hosts allowed to verify an account token via GET https://<host>/api/user/profile.
# The app sends the one it already resolved in the x-auth-host header.
AUTH_PROFILE_HOSTS=apiplayer.app,imdb7.plus,manko.fun,solji.kim

# Cost / abuse limits
DAILY_MESSAGE_LIMIT=200
MAX_INPUT_CHARS=1000
HISTORY_MESSAGES=30
MAX_OUTPUT_TOKENS=500

# Only actresses whose Korean description has at least this many characters can be chatted with
MIN_DESCRIPTION_CHARS=300

# Replaces the wasabi avatar host so mainland-China users get the CDN copy
IMAGE_CDN_BASE=https://image.healertanker.com
