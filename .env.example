# Port the pm2 process listens on (nginx proxies /chat-ai/ to it)
PORT=8004

# Same MongoDB as swipex_nodejs (db swipexdevdb, collection actress_new is read-only here)
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/swipexdevdb
MONGODB_DB=swipexdevdb

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# TMDB v4 read token (movie / TV charts for recommendations); AniList (anime) needs no key
TMDB_API_BEARER=

# Funny-post links for Korean users: 0 switches the feed collector off; refresh period in minutes (>= 10 recommended)
HUMOR_ENABLED=1
HUMOR_REFRESH_MINUTES=10

# Cost / abuse limits. Product-code ("품번") requests cost no DeepSeek tokens (answered from the
# catalogue, never the model — see src/productList.js) and count against none of these; they only
# go through src/rateLimit.js (10/minute, 100/hour per account or IP; not env-configurable).
#
# Time-limited membership (12/6/3/1-month plans): daily AND calendar-month caps.
DAILY_MESSAGE_LIMIT=15
MONTHLY_MESSAGE_LIMIT=300
# "Lifetime" membership (a one-time purchase; detected as membership balance >= this many years
# left — the lifetime plan grants 100 years at purchase): one running total, for as long as the
# account exists, instead of a daily/monthly cap (a one-time payment can't fund an unbounded one).
LIFETIME_THRESHOLD_YEARS=10
LIFETIME_MESSAGE_LIMIT=3600
MAX_INPUT_CHARS=1000
HISTORY_MESSAGES=30
MAX_OUTPUT_TOKENS=700

# Only actresses whose Korean description has at least this many characters can be chatted with
MIN_DESCRIPTION_CHARS=300
